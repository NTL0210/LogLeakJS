{
  "name": "logleak-test",
  "version": "0.1.0",
  "description": "Detect sensitive values in log output emitted during automated tests, and fail the test without leaking the values into the report.",
  "license": "MIT",
  "author": "NTL",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./pino": "./src/capture/pino.js",
    "./winston": "./src/capture/winston.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:package": "node scripts/check-package.mjs",
    "verify": "npm run lint && npm test && npm run check:secrets && npm run check:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NTL0210/LogLeakJS.git"
  },
  "bugs": {
    "url": "https://github.com/NTL0210/LogLeakJS/issues"
  },
  "homepage": "https://github.com/NTL0210/LogLeakJS#readme",
  "keywords": [
    "logging",
    "security",
    "secrets",
    "testing",
    "pino",
    "winston",
    "pii",
    "canary"
  ],
  "peerDependencies": {
    "pino": ">=8.0.0",
    "winston": ">=3.0.0",
    "winston-transport": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    },
    "winston": {
      "optional": true
    },
    "winston-transport": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pino": "^10.4.0",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  }
}
